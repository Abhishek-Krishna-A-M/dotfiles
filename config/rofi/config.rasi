configuration {
    /* Performance Constraints */
    modi: "drun,run";
    
    font: "FiraCode Nerd Font 10"; 
    show-icons: false;
    terminal: "foot"; 
    
    drun-use-desktop-cache: true;
    drun-reload-desktop-cache: false;
    
    /* Blazing Fast Matching Flags */
    case-sensitive: false;
    matching: "regex";  /* Faster string-stream handling on older CPUs */
    tokenize: true;    
    drun-match-fields: "name"; /* Stripped down to name only to skip exec paths parsing */
    drun-display-format: "{name}";

    /* Vim-style Navigation Keybinds */
    kb-row-up: "Up,Control+p";
    kb-row-down: "Down,Control+n";
    kb-accept-entry: "Return,KP_Enter";
    kb-cancel: "Escape,Control+g";
    
    /* Window Switcher Settings */
    window-match-fields: "title,class";
    window-format: "{w} · {c} · {t}";
}

@theme "/dev/null"

* {
    /* #000409 at 80% opacity (0.8) */
    bg:      rgba(0, 4, 9, 0.9);   
    fg:      #ffffff;   
    sel-bg:  #ffffff;   
    sel-fg:  #000409;   
    
    background-color: transparent;
    text-color:       @fg;
}

window {
    anchor:           center;
    location:         center;
    width:            32%; 
    
    background-color: @bg; 
    
    border:           2px;
    border-color:     #ffffff; 
    padding:          12px;
}

mainbox {
    children: [ inputbar, listview ];
}

inputbar {
    spacing:    0px;
    text-color: @fg;
    padding:    4px 4px 12px 4px; 
    children:   [ prompt, entry ];
}

prompt {
    padding:    0px 8px 0px 0px;
    text-color: #ffffff; 
    font:       "FiraCode Nerd Font Bold 10";
}

entry {
    text-color:        #ffffff;
    placeholder:       "";
}

listview {
    lines:        5; 
    columns:      1;
    fixed-height: true;
    scrollbar:    false;
    spacing:      4px;
}

element {
    padding: 6px;
    border-radius: 3px; 
}

element selected {
    background-color: @sel-bg;
    text-color:       @sel-fg;
}

element-text {
    background-color: inherit;
    text-color:       inherit;
}
