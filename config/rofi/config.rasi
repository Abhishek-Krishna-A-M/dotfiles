configuration {
    /* Performance Constraints */
    modi: "drun,run";
    
    font: "Monospace 12"; 
    show-icons: false;
    terminal: "foot"; 
    
    drun-use-desktop-cache: true;
    drun-reload-desktop-cache: true;
    
    /* Blazing Fast Matching Flags */
    case-sensitive: false;
    matching: "regex";  
    sort:false;
    tokenize: true;    
    drun-display-format: "{name}";

    /* Window Switcher Settings */
    window-match-fields: "title,class";
    window-format: "{w} · {c} · {t}";
}

@theme "/dev/null"

* {
    bg:      #000409;   
    fg:      #ffffff;   
    sel-bg:  #ffffff;   
    sel-fg:  #000409;   
    
    background-color: transparent;
    text-color:       @fg;
}

window {
    anchor:           center;
    location:         center;
    width:            28%; 
    
    background-color: @bg; 
    
    border:           2px;
    border-color:     #ffffff; 
    padding:          12px;
}

mainbox {
    children: [ inputbar, listview ];
}

inputbar {
    spacing:    0px;
    text-color: @fg;
    padding:    4px 4px 12px 4px; 
    children:   [ prompt, entry ];
}

prompt {
    padding:    0px 8px 0px 0px;
    text-color: #ffffff; 
    font:       "JetBrains Mono 12";
}

entry {
    text-color:        #ffffff;
    placeholder:       "";
}

listview {
    lines:        5; 
    columns:      1;
    fixed-height: true;
    scrollbar:    false;
    spacing:      4px;
}

element {
    padding: 6px;
}

element selected {
    background-color: @sel-bg;
    text-color:       @sel-fg;
}

element-text {
    background-color: inherit;
    text-color:       inherit;
}
